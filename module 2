% DETERMINANT
% =================================================

\section{Determinants and Inverse Matrices}

\begin{frame}{Determinant}

The determinant is a scalar value associated with a square matrix.

For

\[
A=
\begin{bmatrix}
a&b\\
c&d
\end{bmatrix}
\]

the determinant is

\[
\boxed{
\det(A)=ad-bc
}
\]

\textbf{Example:}

\[
A=
\begin{bmatrix}
2&1\\
3&4
\end{bmatrix}
\]

Therefore,

\[
\det(A)
=
(2)(4)-(1)(3)
=
8-3
=
5.
\]

\end{frame}

% -------------------------------------------------

\begin{frame}{Geometric Meaning of Determinant}

For a two-dimensional transformation, the absolute value of
the determinant represents the factor by which area changes.

If

\[
|\det(A)|=5,
\]

then an area of $1$ becomes an area of $5$.

If

\[
\det(A)=0,
\]

the transformation collapses the plane into a lower-dimensional
space.

\begin{center}

\begin{tikzpicture}[scale=0.7]

\draw[->] (-0.5,0)--(4,0);
\draw[->] (0,-0.5)--(0,4);

\draw[thick] (0,0)--(2,0)--(2,2)--(0,2)--cycle;

\node at (1,1) {Area};

\end{tikzpicture}

\end{center}

\end{frame}

% =================================================
% INVERSE
% =================================================

\begin{frame}{Inverse Matrix}

The inverse of a matrix $A$ is written as

\[
A^{-1}.
\]

It satisfies

\[
AA^{-1}=A^{-1}A=I.
\]

For

\[
A=
\begin{bmatrix}
a&b\\
c&d
\end{bmatrix},
\]

\[
A^{-1}
=
\frac{1}{ad-bc}
\begin{bmatrix}
d&-b\\
-c&a
\end{bmatrix}.
\]

The inverse exists only when

\[
\det(A)\neq0.
\]

\end{frame}

% =================================================
% COLUMN SPACE
% =================================================

\section{Column Space and Null Space}

\begin{frame}{Column Space}

The column space of a matrix is the set of all linear
combinations of its columns.

For

\[
A=
\begin{bmatrix}
1&0\\
0&1
\end{bmatrix}
\]

the columns are

\[
\mathbf c_1=
\begin{bmatrix}
1\\0
\end{bmatrix},
\qquad
\mathbf c_2=
\begin{bmatrix}
0\\1
\end{bmatrix}.
\]

Therefore,

\[
\operatorname{Col}(A)=\mathbb R^2.
\]

\end{frame}

% =================================================
% NULL SPACE
% =================================================

\begin{frame}{Null Space}

The null space contains all vectors $\mathbf x$ satisfying

\[
A\mathbf x=\mathbf0.
\]

\textbf{Example:}

Let

\[
A=
\begin{bmatrix}
1&1\\
2&2
\end{bmatrix}.
\]

We solve

\[
A
\begin{bmatrix}
x\\y
\end{bmatrix}
=
\begin{bmatrix}
0\\0
\end{bmatrix}.
\]

This gives

\[
x+y=0.
\]

Therefore,

\[
y=-x.
\]

The null space is

\[
\operatorname{Null}(A)
=
\left\{
\begin{bmatrix}
t\\-t
\end{bmatrix}
:t\in\mathbb R
\right\}.
\]

\end{frame}

% =================================================
% NONSQUARE
% =================================================

\section{Nonsquare Matrices}

\begin{frame}{Nonsquare Matrices}

A nonsquare matrix has different numbers of rows and columns.

For example,

\[
A=
\begin{bmatrix}
1&0\\
0&1\\
1&1
\end{bmatrix}
\]

is a $3\times2$ matrix.

It maps

\[
\boxed{\mathbb R^2\rightarrow\mathbb R^3}
\]

because a two-dimensional vector is multiplied by the matrix
to produce a three-dimensional vector.

\end{frame}

% =================================================
% DOT PRODUCT
% =================================================

\section{Dot Product and Duality}

\begin{frame}{Dot Product}

The dot product of two vectors is

\[
\mathbf u\cdot\mathbf v
=
u_1v_1+u_2v_2+\cdots+u_nv_n.
\]

For two-dimensional vectors,

\[
\mathbf u=
\begin{bmatrix}
u_1\\u_2
\end{bmatrix},
\qquad
\mathbf v=
\begin{bmatrix}
v_1\\v_2
\end{bmatrix}
\]

we have

\[
\mathbf u\cdot\mathbf v
=
u_1v_1+u_2v_2.
\]

\textbf{Example:}

\[
\mathbf u=(2,3),
\qquad
\mathbf v=(4,1)
\]

Therefore,

\[
\mathbf u\cdot\mathbf v
=
(2)(4)+(3)(1)
=
11.
\]

\end{frame}

% -------------------------------------------------

\begin{frame}{Geometric Meaning of Dot Product}

The dot product can also be written as

\[
\boxed{
\mathbf u\cdot\mathbf v
=
|\mathbf u||\mathbf v|\cos\theta
}
\]

where $\theta$ is the angle between the vectors.

\begin{center}

\begin{tikzpicture}[scale=0.8]

\draw[->,thick] (0,0)--(4,1.5)
node[right]{$\mathbf u$};

\draw[->,thick] (0,0)--(3,3)
node[above]{$\mathbf v$};

\draw (1,0.38) arc[start angle=20,end angle=45,radius=1];

\node at (1.15,0.9) {$\theta$};

\end{tikzpicture}

\end{center}

If

\[
\mathbf u\cdot\mathbf v=0,
\]

then the vectors are perpendicular.

\end{frame}

% =================================================
% DUALITY
% =================================================

\begin{frame}{Duality}

Duality describes the relationship between vectors and linear
functions that act on vectors.

A linear functional can be represented as

\[
f(\mathbf x)=\mathbf a^T\mathbf x.
\]

For

\[
\mathbf a=
\begin{bmatrix}
2\\1
\end{bmatrix},
\qquad
\mathbf x=
\begin{bmatrix}
x\\y
\end{bmatrix},
\]

we get

\[
f(\mathbf x)=2x+y.
\]

Thus, a vector can define a linear measurement of another vector.

\end{frame}

% =================================================
% CROSS PRODUCT
% =================================================

\section{Cross Products}

\begin{frame}{Cross Product}

The cross product is defined for vectors in $\mathbb R^3$.

For

\[
\mathbf u=(u_1,u_2,u_3)
\]

and

\[
\mathbf v=(v_1,v_2,v_3),
\]

the cross product is

\[
\mathbf u\times\mathbf v
=
\begin{vmatrix}
\mathbf i&\mathbf j&\mathbf k\\
u_1&u_2&u_3\\
v_1&v_2&v_3
\end{vmatrix}.
\]

The resulting vector is perpendicular to both $\mathbf u$
and $\mathbf v$.

\end{frame}

% -------------------------------------------------

\begin{frame}{Cross Product Example}

Let

\[
\mathbf u=(1,0,0)
\]

and

\[
\mathbf v=(0,1,0).
\]

Then

\[
\mathbf u\times\mathbf v
=
(0,0,1).
\]

Therefore,

\[
\boxed{
\mathbf u\times\mathbf v=\mathbf k
}
\]

The resulting vector is perpendicular to both original vectors.

\end{frame}

% =================================================
% CROSS PRODUCT TRANSFORMATION
% =================================================

\begin{frame}{Cross Product and Transformations}

The cross product has a geometric meaning related to area.

The magnitude is

\[
|\mathbf u\times\mathbf v|
=
|\mathbf u||\mathbf v|\sin\theta.
\]

This represents the area of the parallelogram formed by
$\mathbf u$ and $\mathbf v$.

\begin{center}

\begin{tikzpicture}[scale=0.8]

\draw[->,thick] (0,0)--(3,1)
node[right]{$\mathbf u$};

\draw[->,thick] (0,0)--(1,3)
node[above]{$\mathbf v$};

\draw[dashed] (3,1)--(4,4);
\draw[dashed] (1,3)--(4,4);

\node at (2,2) {Area};

\end{tikzpicture}

\end{center}

\end{frame}

