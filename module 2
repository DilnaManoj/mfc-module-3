% CRAMER
% =================================================

\section{Cramer's Rule}

\begin{frame}{Cramer's Rule}

Cramer's Rule is a method for solving a system of linear
equations using determinants.

Consider

\[
a_1x+b_1y=c_1
\]

\[
a_2x+b_2y=c_2.
\]

The determinant is

\[
D=
\begin{vmatrix}
a_1&b_1\\
a_2&b_2
\end{vmatrix}.
\]

Then

\[
x=\frac{D_x}{D},
\qquad
y=\frac{D_y}{D}.
\]

\end{frame}

% -------------------------------------------------

\begin{frame}{Cramer's Rule Example}

Solve:

\[
2x+y=5
\]

\[
x-y=1.
\]

Main determinant:

\[
D=
\begin{vmatrix}
2&1\\
1&-1
\end{vmatrix}
=-3.
\]

For $x$:

\[
D_x=
\begin{vmatrix}
5&1\\
1&-1
\end{vmatrix}
=-6.
\]

Therefore,

\[
x=\frac{-6}{-3}=2.
\]

Similarly,

\[
y=1.
\]

Hence,

\[
\boxed{x=2,\quad y=1}
\]

\end{frame}

