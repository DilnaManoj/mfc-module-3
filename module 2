\section{Matrices as Linear Transformations}

\begin{frame}{Matrix as a Transformation}

A matrix can transform a vector from one position to another.

If

\[
A=
\begin{bmatrix}
2&0\\
0&1
\end{bmatrix}
\]

and

\[
\mathbf v=
\begin{bmatrix}
1\\
2
\end{bmatrix}
\]

then

\[
A\mathbf v
=
\begin{bmatrix}
2&0\\
0&1
\end{bmatrix}
\begin{bmatrix}
1\\
2
\end{bmatrix}
=
\begin{bmatrix}
2\\
2
\end{bmatrix}.
\]

The matrix stretches the vector in the $x$ direction.

\end{frame}

% -------------------------------------------------

\begin{frame}{Matrix Transformation Graph}

\begin{columns}

\column{0.48\textwidth}

\[
\mathbf v=(1,2)
\]

After transformation:

\[
A\mathbf v=(2,2)
\]

The $x$ coordinate is doubled.

\column{0.52\textwidth}

\begin{center}

\begin{tikzpicture}[scale=0.8]

\draw[->] (-0.5,0)--(3.5,0) node[right]{$x$};
\draw[->] (0,-0.5)--(0,3.5) node[above]{$y$};

\draw[->,thick] (0,0)--(1,2)
node[midway,left]{$\mathbf v$};

\draw[->,thick] (0,0)--(2,2)
node[midway,above]{$A\mathbf v$};

\end{tikzpicture}

\end{center}

\end{columns}

\end{frame}

% =================================================
% COMPOSITION
% =================================================

\begin{frame}{Matrix Multiplication as Composition}

Two transformations can be applied one after another.

Suppose

\[
A\mathbf v
\]

is the first transformation and

\[
B(A\mathbf v)
\]

is the second transformation.

Therefore,

\[
B(A\mathbf v)
=
(BA)\mathbf v.
\]

Thus, matrix multiplication represents the composition of
linear transformations.

\[
\boxed{BA}
\]

means that $A$ is applied first and $B$ is applied second.

\end{frame}

% =================================================
% 3D TRANSFORMATION
% =================================================

\begin{frame}{Three-Dimensional Linear Transformation}

A three-dimensional vector has three components:

\[
\mathbf v=
\begin{bmatrix}
x\\
y\\
z
\end{bmatrix}.
\]

A $3\times3$ matrix can transform this vector.

For example,

\[
A=
\begin{bmatrix}
2&0&0\\
0&2&0\\
0&0&1
\end{bmatrix}
\]

scales the $x$ and $y$ coordinates by 2.

\end{frame}

