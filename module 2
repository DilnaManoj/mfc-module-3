% VECTOR ADDITION
% =================================================

\section{Vector Operations}

\begin{frame}{Vector Addition}

Vector addition means adding the corresponding components
of two vectors.

If

\[
\mathbf u=
\begin{bmatrix}
u_1\\
u_2
\end{bmatrix},
\qquad
\mathbf v=
\begin{bmatrix}
v_1\\
v_2
\end{bmatrix}
\]

then

\[
\mathbf u+\mathbf v
=
\begin{bmatrix}
u_1+v_1\\
u_2+v_2
\end{bmatrix}
\]

\textbf{Example:}

\[
\mathbf u=
\begin{bmatrix}
2\\
1
\end{bmatrix},
\qquad
\mathbf v=
\begin{bmatrix}
1\\
3
\end{bmatrix}
\]

Therefore,

\[
\boxed{
\mathbf u+\mathbf v=
\begin{bmatrix}
3\\
4
\end{bmatrix}}
\]

\end{frame}

% -------------------------------------------------

\begin{frame}{Vector Addition Graph}

\begin{center}

\begin{tikzpicture}[scale=0.8]

